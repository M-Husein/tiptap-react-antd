{
  "name": "tiptap-react-antd",
  "private": true,
  "version": "0.1.0",
  "description": "Tiptap + Ant Design Rich Text Editor / Viewer for React",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:content": "tsx scripts/smoke-test-content.ts",
    "test:demo-render": "tsx scripts/smoke-test-demo-render.ts",
    "lint": "echo \"(add eslint config as needed)\"",
    "check:viewer-bundle": "node scripts/check-viewer-bundle.mjs",
    "test:math-editor": "tsx scripts/smoke-test-math-editor.ts",
    "test": "npm run typecheck && npm run test:content && npm run test:math-editor && npm run test:codeblock && npm run test:codeblock-ui && npm run test:demo-render && npm run check:viewer-bundle",
    "generate:code-languages": "node scripts/generate-code-languages.mjs",
    "test:codeblock": "tsx scripts/smoke-test-codeblock.ts",
    "test:codeblock-ui": "tsx scripts/smoke-test-codeblock-ui.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-character-count": "^3.33.1",
    "@tiptap/extension-code-block": "^3.33.1",
    "@tiptap/extension-link": "^3.33.1",
    "@tiptap/extension-placeholder": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extension-table-cell": "^3.33.1",
    "@tiptap/extension-table-header": "^3.33.1",
    "@tiptap/extension-table-row": "^3.33.1",
    "@tiptap/extension-task-item": "^3.33.1",
    "@tiptap/extension-task-list": "^3.33.1",
    "@tiptap/extension-underline": "^3.33.1",
    "@tiptap/html": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "antd": "^6.7.0",
    "markdown-it": "^15.0.3",
    "mathlive": "^0.111.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
